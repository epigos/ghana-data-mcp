{
  "name": "ghana-data-mcp",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "MCP server exposing public Ghana data (Ghana Stock Exchange prices and company directory) to AI tools.",
  "license": "MIT",
  "author": "epigos",
  "keywords": [
    "mcp",
    "ghana",
    "ghana-stock-exchange",
    "gse",
    "cloudflare-workers",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epigos/ghana-data-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/epigos/ghana-data-mcp/issues"
  },
  "homepage": "https://github.com/epigos/ghana-data-mcp#readme",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "GSE_LIVE=1 vitest run test/integration",
    "test:live:bog": "BOG_LIVE=1 vitest run test/integration/bog.live.test.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "cf-typegen": "wrangler types",
    "preversion": "npm run typecheck && npm test",
    "version": "node scripts/sync-version.mjs && git add src/meta.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.20.1",
    "linkedom": "^0.18.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.125.0"
  }
}
